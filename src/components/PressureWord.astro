---
const letters = [..."SKERTER"];
---

<h1
  id="hero-title"
  class="pressure-word"
  data-pressure-word
  aria-label="SKERTER"
>
  {
    letters.map((letter, index) => (
      <span
        class="pressure-cell"
        data-pressure-cell
        style={`--wave-delay: ${index * 42}ms`}
        aria-hidden="true"
      >
        <span class="pressure-cell__number">
          {String(index + 1).padStart(2, "0")}
        </span>
        <span class="pressure-glyph" data-pressure-glyph>{letter}</span>
        <span class="pressure-cell__meter">
          <span></span>
        </span>
      </span>
    ))
  }

</h1>

<p class="pressure-stage__side-label" aria-hidden="true">
  Python / backend / ML systems
</p>

<div class="pressure-readout" data-pressure-readout aria-hidden="true">
  <span data-pressure-cell-label>Glyph 04</span>
  <span data-pressure-force>Force 00</span>
</div>

<p class="pressure-mobile-hint" aria-hidden="true">Tap anywhere / response 01</p>
