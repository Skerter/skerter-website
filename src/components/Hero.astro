    <a class="quiet-home__identity" href="/" aria-label="Skerter home">
      Skerter
    </a>

    <nav class="quiet-home__nav" aria-label="Primary navigation">
      <a class="quiet-home__nav-link" href="/projects/">
        Projects
        <span aria-hidden="true">&nearr;</span>
      </a>
      <a class="quiet-home__nav-link" href="/contacts/">
        Contact
        <span aria-hidden="true">&nearr;</span>
      </a>
    </nav>
  </header>

  <section id="intro" class="quiet-home__intro" aria-labelledby="hero-title">
    <a class="quiet-home__statement" href="/projects/">
      <h1 id="hero-title">
        <span class="quiet-home__line">I build the parts</span>
        <span class="quiet-home__line">
          you don&rsquo;t <span class="quiet-home__emphasis">see<span class="quiet-home__period" aria-hidden="true">.</span></span>
        </span>
